+
+  // GET /api/runtime/routing — текущий role-routing. Без авторизации
+  // owner (только authOrApiToken): это диагностика, не запись.
+  app.get("/api/runtime/routing", { preHandler: authPre }, async () => {
+    const routing = loadRoleRouting();
