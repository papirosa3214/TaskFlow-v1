 type Participant = { id: string; name: string; type: string }
 
+// Строки created_at из БД — UTC (datetime(now) без зоны), читаются как
+// MSK они на три часа позже факта. Без явного перевода в meta.ts агент видит
+// 23:50 там, где владелец сказал «02:50» (29.08.2026, f5b8cc34). Хранение
+// в UTC не трогаем — это только про отдачу в канал. Тот же формат, что у
+// formatAbsoluteTime в src/lib/date.ts.
+const MSK_TZ = 'Europe/Moscow'
+const MONTHS_SHORT = [
+  'янв', 'фев', 'мар', 'апр', 'мая', 'июн',
+  'июл', 'авг', 'сен', 'окт', 'ноя', 'дек',
+]
+function formatMsk(sqliteDatetime: string): string {
+  if (!sqliteDatetime) return ''
+  const d = new Date(sqliteDatetime.replace(' ', 'T') + 'Z')
+  if (isNaN(d.getTime())) return sqliteDatetime
+  const parts = new Intl.DateTimeFormat('ru-RU', {
+    timeZone: MSK_TZ,
+    year: 'numeric', month: '2-digit', day: '2-digit',
+    hour: '2-digit', minute: '2-digit', hour12: false,
+  }).formatToParts(d)
+  const get = (t: string) => parts.find(p => p.type === t)?.value ?? '00'
+  const hh = get('hour'); const mi = get('minute')
+  const thatMsk = new Date(get('year') + '-' + get('month') + '-' + get('day') + 'T00:00:00Z')
+  const todayMsk = new Date(
+    new Date().toLocaleDateString('en-CA', { timeZone: MSK_TZ }) + 'T00:00:00Z',
+  )
+  const dayDiff = Math.round((todayMsk.getTime() - thatMsk.getTime()) / 86_400_000)
+  if (dayDiff <= 0) return hh + ':' + mi
+  const day = thatMsk.getUTCDate()
+  const month = MONTHS_SHORT[thatMsk.getUTCMonth()]
+  return day + ' ' + month + ', ' + hh + ':' + mi
+}
