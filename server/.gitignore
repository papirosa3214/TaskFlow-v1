# Зависимости
node_modules/

# Сборка веба
dist/

# Веб-бандл внутри iOS-проекта — генерируется `vite build` + `cap sync ios`,
# в репозитории не нужен. ВАЖНО при сборке из чистого клона: собирать с
# явным адресом API, иначе приложение откроется, но не загрузит данные
# (same-origin fallback молча ломается в native-режиме):
#   VITE_API_URL=http://192.168.1.110:3001 npx vite build && npx cap sync ios
ios/App/App/public/

# Xcode
ios/App/build/
ios/App/DerivedData/
*.xcuserstate
xcuserdata/
ios/App/App.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/configuration/

# Локальная БД разработки
db.sqlite
*.sqlite-journal

# macOS
.DS_Store

# Логи и окружение
*.log
.env
.env.local

# Служебные каталоги Claude Code. В worktrees/ оседают брошенные рабочие
# копии — внутри полный дубль самого проекта, к TaskFlow отношения не имеет.
.claude/

# Мусор macOS от SMB/Dropbox (AppleDouble-спутники файлов)
._*
.AppleDouble

# Сохранённая сессия браузерного харнесса — внутри живой JWT. Учётные данные
# в репозиторий не кладём: то же правило, по которому пароль в
# scripts/screenshot.mjs берётся только из окружения, а зашитый JWT_SECRET
# убран из server/src/env.ts.
scripts/auth-state.json

# ═══════ Сохранено из копии на .110 при слиянии 18.08.2026 ═══════
# Живые данные сервера: база и загруженные файлы лежат рядом с кодом, но
# принадлежат работающему приложению, а не репозиторию.
logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
node_modules
dist
dist-ssr
*.local
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
server/taskflow.db*
server/node_modules
mockup-reference/__pycache__
server/uploads/
server/.env
scripts/*.png
ios/App/Pods/
ios/App/output/
ios/DerivedData/
ios/**/xcuserdata/
ios/**/*.xcuserstate

# Артефакты прогонов playwright — не код
test-results/
server/scripts/__pycache__/
.hermes/

# Домашний каталог DeepSeek Harness и его отладочные дампы — 200+ МБ чужого
# состояния, осевшего рядом с кодом. Опасно именно размером: один `git add -A`
# затягивает их в историю навсегда.
.dsh-home/
server/scripts/.dsh-debug/

# Черновики агента по интерфейсу и временные копии базы из ручных прогонов.
.ui-craft/
zzz.db

# Отладочные снимки прогонов по референсу — 7,6 МБ, воспроизводятся screenshot.mjs
mockup-reference/nav-artifact/_shots/

# Байткод Python и состояние сторожа будильника: следы работы, а не код.
# Отслеживались с самого начала и пачкали дерево на каждом запуске —
# каждый прогон trigger.py показывался как «изменения» (08.09.2026).
server/scripts/__pycache__/
server/agent-watch.state.json

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Локальная БД разработки (SQLite, регенерируется миграциями)
server/dev.db

# Кэш инкрементальной компиляции TypeScript — регенерируется tsc
*.tsbuildinfo

# Сторож планировщика расписания — состояние между прогонами (не в репо, как agent-watch).
server/scheduler-watch.state.json
server/agents/secretary-voice/__pycache__/
server/secretary-voice-watch.state.json
